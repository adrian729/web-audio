{
  "name": "@polyhymnia/web-audio",
  "version": "0.1.0",
  "description": "Web Audio playback of MIDI note events: event builders, synth, sampler and player. No dependencies.",
  "keywords": [
    "web-audio",
    "music",
    "midi",
    "synth",
    "sampler"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webaudio": {
      "types": "./dist/webaudio/index.d.ts",
      "default": "./dist/webaudio/index.js"
    },
    "./sampler": {
      "types": "./dist/sampler/index.d.ts",
      "default": "./dist/sampler/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.webaudio.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webaudio.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/web-audio.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.3.2",
  "homepage": "https://github.com/adrian729/web-audio#readme",
  "bugs": {
    "url": "https://github.com/adrian729/web-audio/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
